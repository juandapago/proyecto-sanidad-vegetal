meta {
  name: Preparar - crear patógeno
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pathogens
  body: json
  auth: none
}

body:json {
  {
    "name": "Pudrición del cogollo",
    "scientificName": "Phytophthora palmivora",
    "pathogenType": "oomiceto",
    "transmissionMode": "agua",
    "geneticSequence": "TTGACCAGTGCA"
  }
}

vars:post-response {
  pathogenId: res.body.id
}

assert {
  res.status: eq 201
}
