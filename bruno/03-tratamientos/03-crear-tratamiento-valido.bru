meta {
  name: Crear tratamiento válido
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/treatments
  body: json
  auth: none
}

body:json {
  {
    "name": "Fungicida a base de cobre",
    "applicationDescription": "Aplicar oxicloruro de cobre al cogollo cada 30 días en época de lluvias",
    "treatmentType": "quimico",
    "diseaseId": {{diseaseId}}
  }
}

vars:post-response {
  treatmentId: res.body.id
}

assert {
  res.status: eq 201
}
