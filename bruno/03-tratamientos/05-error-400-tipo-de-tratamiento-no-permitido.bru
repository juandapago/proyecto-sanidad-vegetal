meta {
  name: Error 400 - tipo de tratamiento no permitido
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/treatments
  body: json
  auth: none
}

body:json {
  {
    "name": "Fungicida a base de cobre",
    "applicationDescription": "Aplicar oxicloruro de cobre al cogollo cada 30 días en época de lluvias",
    "treatmentType": "químico",
    "diseaseId": {{diseaseId}}
  }
}

assert {
  res.status: eq 400
}
