meta {
  name: Error 404 - enfermedad que no existe
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/outbreaks
  body: json
  auth: none
}

body:json {
  {
    "plantId": 1,
    "diseaseId": 9999,
