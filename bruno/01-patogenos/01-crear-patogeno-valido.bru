meta {
  name: Crear patógeno válido
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pathogens
  body: json
  auth: none
}

body:json {
  {
    "name": "Antracnosis",
    "scientificName": "Colletotrichum gloeosporioides",
    "pathogenType": "hongo",
    "transmissionMode": "agua de lluvia",
    "geneticSequence": "ACGTTGCAACGTAGCT"
  }
}

vars:post-response {
  pathogenId: res.body.id
}

assert {
  res.status: eq 201
}
