meta {
  name: Error 409 - nombre científico repetido
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/pathogens
  body: json
  auth: none
}

body:json {
  {
    "name": "Antracnosis",
    "scientificName": "Colletotrichum gloeosporioides",
    "pathogenType": "hongo",
    "transmissionMode": "agua de lluvia",
    "geneticSequence": "ACGTTGCAACGTAGCT"
  }
}

assert {
  res.status: eq 409
}
