meta {
  name: Preparar - crear enfermedad causada por el patógeno
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/diseases
  body: json
  auth: none
}

body:json {
  {
    "name": "Antracnosis del mango",
    "symptoms": "Manchas negras hundidas en hojas y frutos",
    "riskSeason": "verano",
    "pathogenId": {{pathogenId}}
  }
}

vars:post-response {
  pathogenDiseaseId: res.body.id
}

assert {
  res.status: eq 201
}
