meta {
  name: Preparar - crear tratamiento
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/treatments
  body: json
  auth: none
}

body:json {
  {
    "name": "Caldo bordelés para uchuva",
    "applicationDescription": "Aplicar sobre las hojas cada 8 días en época de lluvia",
    "treatmentType": "quimico",
    "diseaseId": {{diseaseId}}
  }
}

vars:post-response {
  treatmentId: res.body.id
}

assert {
  res.status: eq 201
}
