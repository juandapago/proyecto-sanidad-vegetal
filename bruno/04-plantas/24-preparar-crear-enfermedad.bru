meta {
  name: Preparar - crear enfermedad
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/diseases
  body: json
  auth: none
}

body:json {
  {
    "name": "Mancha de la uchuva",
    "symptoms": "Manchas oscuras en hojas y tallos que avanzan rápido con la humedad",
    "riskSeason": "invierno",
    "pathogenId": {{pathogenId}}
  }
}

vars:post-response {
  diseaseId: res.body.id
}

assert {
  res.status: eq 201
}
