meta {
  name: Crear cultivo válido
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/crops
  body: json
  auth: none
}

body:json {
  {
    "plantId": {{plantId}},
    "lot": "Lote 7",
    "region": "Tolima",
    "sowingDate": "2026-03-15",
    "seedGeneticCode": "ACGAACGTACGA"
  }
}

vars:post-response {
  cropId: res.body.id
}

assert {
  res.status: eq 201
}
