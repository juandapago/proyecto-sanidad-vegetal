meta {
  name: Error 400 - fecha que no existe
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/crops
  body: json
  auth: none
}

body:json {
  {
    "plantId": {{plantId}},
    "lot": "Lote 7",
    "region": "Tolima",
    "sowingDate": "2026-02-30",
    "seedGeneticCode": "ACGAACGTACGA"
  }
}

assert {
  res.status: eq 400
}
