meta {
  name: Error 404 - planta que no existe
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/crops
  body: json
  auth: none
}

body:json {
  {
    "plantId": 999999,
    "lot": "Lote 7",
    "region": "Tolima",
    "sowingDate": "2026-03-15",
    "seedGeneticCode": "ACGAACGTACGA"
  }
}

assert {
  res.status: eq 404
}
