meta {
  name: Error 400 - época de riesgo no permitida
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/diseases
  body: json
  auth: none
}

body:json {
  {
    "name": "Prueba epoca",
    "symptoms": "Rayas cafés en las hojas que se vuelven manchas negras y secan la hoja",
    "riskSeason": "otoño",
    "pathogenId": {{pathogenId}}
  }
}

assert {
  res.status: eq 400
}
