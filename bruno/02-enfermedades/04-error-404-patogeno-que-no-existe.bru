meta {
  name: Error 404 - patógeno que no existe
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/diseases
  body: json
  auth: none
}

body:json {
  {
    "name": "Prueba patogeno",
    "symptoms": "Rayas cafés en las hojas que se vuelven manchas negras y secan la hoja",
    "riskSeason": "todo_el_ano",
    "pathogenId": 999999
  }
}

assert {
  res.status: eq 404
}
