meta {
  name: Preparar - crear brote
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/outbreaks
  body: json
  auth: none
}

body:json {
  {
    "plantId": {{plantId}},
    "diseaseId": {{diseaseId}},
    "reportDate": "2026-09-15",
    "region": "Urabá",
    "affectedHectares": 8.5
  }
}

vars:post-response {
  outbreakId: res.body.id
}

assert {
  res.status: eq 201
}
