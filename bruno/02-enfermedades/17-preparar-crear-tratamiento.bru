meta {
  name: Preparar - crear tratamiento
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/treatments
  body: json
  auth: none
}

body:json {
  {
    "name": "Deshoje sanitario",
    "applicationDescription": "Cortar y retirar las hojas con más del 50 % de daño cada 15 días",
    "treatmentType": "cultural",
    "diseaseId": {{diseaseId}}
  }
}

vars:post-response {
  treatmentId: res.body.id
}

assert {
  res.status: eq 201
}
