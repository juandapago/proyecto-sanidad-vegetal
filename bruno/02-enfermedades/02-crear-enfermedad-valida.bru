meta {
  name: Crear enfermedad válida
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/diseases
  body: json
  auth: none
}

body:json {
  {
    "name": "Sigatoka negra",
    "symptoms": "Rayas cafés en las hojas que se vuelven manchas negras y secan la hoja",
    "riskSeason": "todo_el_ano",
    "pathogenId": {{pathogenId}}
  }
}

vars:post-response {
  diseaseId: res.body.id
}

assert {
  res.status: eq 201
}
