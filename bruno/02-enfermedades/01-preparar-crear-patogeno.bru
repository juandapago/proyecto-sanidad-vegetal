meta {
  name: Preparar - crear patógeno
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pathogens
  body: json
  auth: none
}

body:json {
  {
    "name": "Sigatoka",
    "scientificName": "Mycosphaerella fijiensis",
    "pathogenType": "hongo",
    "transmissionMode": "viento",
    "geneticSequence": "GGATCCTTAGCA"
  }
}

vars:post-response {
  pathogenId: res.body.id
}

assert {
  res.status: eq 201
}
